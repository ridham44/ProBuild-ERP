{
  "name": "@probuild/api-client",
  "version": "0.1.0",
  "private": true,
  "description": "Typed client generated from the API OpenAPI document. Never edit src/schema.d.ts by hand.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "generate": "openapi-typescript openapi.json -o src/schema.d.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": { "openapi-fetch": "0.14.0" },
  "devDependencies": {
    "@probuild/config": "workspace:*",
    "eslint": "9.36.0",
    "openapi-typescript": "7.9.1",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
