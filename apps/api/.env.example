NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://probuild:probuild@localhost:5434/probuild?schema=public
WEB_ORIGINS=http://localhost:3000
SESSION_TTL_HOURS=12
LOG_LEVEL=info
SENTRY_DSN=
# Optional: enables the AI assistant and document extraction (OpenRouter)
OPENROUTER_API_KEY=
OPENROUTER_CHAT_MODEL=
# Optional: expose /docs in production (default false)
ENABLE_API_DOCS=false
# Used by the seed script only; required when NODE_ENV=production
SEED_ADMIN_PASSWORD=
TEST_DATABASE_URL=postgresql://probuild:probuild@localhost:5435/probuild_test?schema=public
