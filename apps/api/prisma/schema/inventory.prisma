// Inventory master, the immutable StockLedger, derived StockBalance, and stock documents.

enum ItemType {
  CONSUMABLE
  NON_CONSUMABLE
  SERIALIZED
  BATCH_CONTROLLED
  LOT_CONTROLLED
  FIXED_ASSET
  RETURNABLE
}

enum CostingMethod {
  WEIGHTED_AVERAGE
  FIFO
  STANDARD
  MOVING_AVERAGE
}

enum StockTxnType {
  OPENING
  PURCHASE_RECEIPT
  CUSTOMER_RETURN
  PROJECT_RETURN
  TRANSFER_IN
  PRODUCTION_RECEIPT
  PROJECT_ISSUE
  TRANSFER_OUT
  SUPPLIER_RETURN
  DAMAGE
  SCRAP
  CONSUMPTION
  ASSET_CAPITALIZATION
  ADJUSTMENT_GAIN
  ADJUSTMENT_LOSS
  COUNT_VARIANCE
  REVERSAL
}

enum StockStatus {
  AVAILABLE
  QUARANTINE
  DAMAGED
  IN_TRANSIT
}

enum ReturnCondition {
  GOOD
  DAMAGED
  QUARANTINE
}

enum SerialStatus {
  IN_STOCK
  ISSUED
  IN_REPAIR
  LOST
  DAMAGED
  DISPOSED
}

model UnitOfMeasure {
  id        String   @id @default(uuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  code      String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, code])
}

// Alternate units for an item. factor = how many base units one of this unit holds (1 box = 12 pcs -> 12).
model ItemUnitConversion {
  id        String   @id @default(uuid())
  companyId String
  itemId    String
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  unit      String
  factor    Decimal  @db.Decimal(18, 6)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([itemId, unit])
  @@index([companyId])
}

model ItemCategory {
  id        String         @id @default(uuid())
  companyId String
  company   Company        @relation(fields: [companyId], references: [id])
  parentId  String?
  parent    ItemCategory?  @relation("ItemCategoryTree", fields: [parentId], references: [id])
  children  ItemCategory[] @relation("ItemCategoryTree")
  name      String
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  deletedAt DateTime?
  items     Item[]

  @@unique([companyId, parentId, name])
  @@index([parentId])
}

model Item {
  id                       String                    @id @default(uuid())
  companyId                String
  company                  Company                   @relation(fields: [companyId], references: [id])
  categoryId               String?
  category                 ItemCategory?             @relation(fields: [categoryId], references: [id])
  preferredSupplierId      String?
  preferredSupplier        Supplier?                 @relation(fields: [preferredSupplierId], references: [id])
  restrictedProjectId      String?
  restrictedProject        Project?                  @relation(fields: [restrictedProjectId], references: [id])
  sku                      String
  name                     String
  description              String?
  brand                    String?
  model                    String?
  specification            String?
  itemType                 ItemType                  @default(CONSUMABLE)
  costCategory             CostCategory              @default(MATERIAL)
  trackBatch               Boolean                   @default(false)
  trackSerial              Boolean                   @default(false)
  trackExpiry              Boolean                   @default(false)
  baseUnit                 String
  purchaseUnit             String?
  issueUnit                String?
  conversionFactor         Decimal                   @default(1) @db.Decimal(18, 6)
  barcode                  String?
  qrCode                   String?
  minStock                 Decimal                   @default(0) @db.Decimal(18, 4)
  maxStock                 Decimal                   @default(0) @db.Decimal(18, 4)
  reorderPoint             Decimal                   @default(0) @db.Decimal(18, 4)
  safetyStock              Decimal                   @default(0) @db.Decimal(18, 4)
  costingMethod            CostingMethod             @default(WEIGHTED_AVERAGE)
  standardCost             Decimal                   @default(0) @db.Decimal(18, 4)
  lastPurchaseCost         Decimal                   @default(0) @db.Decimal(18, 4)
  allowableWastePct        Decimal                   @default(0) @db.Decimal(7, 4)
  active                   Boolean                   @default(true)
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  deletedAt                DateTime?
  stockLedgers             StockLedger[]
  stockBalances            StockBalance[]
  batchRecords             BatchRecord[]
  serialUnits              SerialUnit[]
  ppeIssues                PpeIssue[]
  materialRequestLines     MaterialRequestLine[]
  materialIssueLines       MaterialIssueLine[]
  materialReturnLines      MaterialReturnLine[]
  warehouseTransferLines   WarehouseTransferLine[]
  stockAdjustmentLines     StockAdjustmentLine[]
  stockCountLines          StockCountLine[]
  purchaseRequisitionLines PurchaseRequisitionLine[]
  rfqLines                 RfqLine[]
  supplierQuotationLines   SupplierQuotationLine[]
  purchaseOrderLines       PurchaseOrderLine[]
  goodsReceiptLines        GoodsReceiptLine[]
  rateAnalysisLines        RateAnalysisLine[]
  projectCostLedgers       ProjectCostLedger[]
  unitConversions          ItemUnitConversion[]

  @@unique([companyId, sku])
  @@index([companyId, barcode])
  @@index([categoryId])
  @@index([preferredSupplierId])
  @@index([restrictedProjectId])
}

// IMMUTABLE. Stock balance is derived from this table. Corrections are new REVERSAL rows.
// qty is signed: positive = in, negative = out. value is signed the same way.
model StockLedger {
  id           String             @id @default(uuid())
  companyId    String
  company      Company            @relation(fields: [companyId], references: [id])
  txnNo        String
  txnDate      DateTime
  txnType      StockTxnType
  warehouseId  String
  warehouse    Warehouse          @relation(fields: [warehouseId], references: [id])
  locationId   String?
  location     WarehouseLocation? @relation(fields: [locationId], references: [id])
  itemId       String
  item         Item               @relation(fields: [itemId], references: [id])
  batchNo      String             @default("")
  serialNo     String?
  stockStatus  StockStatus        @default(AVAILABLE)
  qty          Decimal            @db.Decimal(18, 4)
  unitCost     Decimal            @db.Decimal(18, 4)
  value        Decimal            @db.Decimal(18, 2)
  runningQty   Decimal            @db.Decimal(18, 4)
  runningValue Decimal            @db.Decimal(18, 2)
  sourceType   String
  sourceId     String
  projectId    String?
  project      Project?           @relation(fields: [projectId], references: [id])
  wbsNodeId    String?
  wbsNode      WbsNode?           @relation(fields: [wbsNodeId], references: [id])
  costCodeId   String?
  costCode     CostCode?          @relation(fields: [costCodeId], references: [id])
  boqItemId    String?
  boqItem      BoqItem?           @relation(fields: [boqItemId], references: [id])
  costCenterId String?
  costCenter   CostCenter?        @relation(fields: [costCenterId], references: [id])
  reversalOfId String?
  reversalOf   StockLedger?       @relation("StockReversal", fields: [reversalOfId], references: [id])
  reversedBy   StockLedger[]      @relation("StockReversal")
  userId       String
  remarks      String?
  createdAt    DateTime           @default(now())

  @@index([companyId, itemId, warehouseId])
  @@index([sourceType, sourceId])
  @@index([batchNo])
  @@index([txnDate])
  @@index([warehouseId])
  @@index([locationId])
  @@index([itemId])
  @@index([projectId])
  @@index([wbsNodeId])
  @@index([costCodeId])
  @@index([boqItemId])
  @@index([costCenterId])
  @@index([reversalOfId])
}

// Cache derived from StockLedger, updated in the same DB transaction as the ledger row.
model StockBalance {
  id          String      @id @default(uuid())
  companyId   String
  company     Company     @relation(fields: [companyId], references: [id])
  warehouseId String
  warehouse   Warehouse   @relation(fields: [warehouseId], references: [id])
  itemId      String
  item        Item        @relation(fields: [itemId], references: [id])
  batchNo     String      @default("")
  stockStatus StockStatus @default(AVAILABLE)
  qtyOnHand   Decimal     @default(0) @db.Decimal(18, 4)
  value       Decimal     @default(0) @db.Decimal(18, 2)
  avgCost     Decimal     @default(0) @db.Decimal(18, 4)
  updatedAt   DateTime    @updatedAt
  createdAt   DateTime    @default(now())

  @@unique([warehouseId, itemId, batchNo, stockStatus])
  @@index([companyId, itemId])
  @@index([itemId])
}

model BatchRecord {
  id              String    @id @default(uuid())
  companyId       String
  company         Company   @relation(fields: [companyId], references: [id])
  itemId          String
  item            Item      @relation(fields: [itemId], references: [id])
  supplierId      String?
  supplier        Supplier? @relation(fields: [supplierId], references: [id])
  batchNo         String
  lotNo           String?
  expiryDate      DateTime?
  millCertificate String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([companyId, itemId, batchNo])
  @@index([itemId])
  @@index([supplierId])
}

// Serialized assets, tools, PPE units.
model SerialUnit {
  id                 String       @id @default(uuid())
  companyId          String
  company            Company      @relation(fields: [companyId], references: [id])
  itemId             String
  item               Item         @relation(fields: [itemId], references: [id])
  serialNo           String
  qrCode             String?
  status             SerialStatus @default(IN_STOCK)
  warehouseId        String?
  warehouse          Warehouse?   @relation(fields: [warehouseId], references: [id])
  projectId          String?
  project            Project?     @relation(fields: [projectId], references: [id])
  assignedEmployeeId String?
  employee           Employee?    @relation(fields: [assignedEmployeeId], references: [id])
  condition          String       @default("GOOD")
  issuedAt           DateTime?
  expectedReturnAt   DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  deletedAt          DateTime?

  @@unique([companyId, itemId, serialNo])
  @@index([itemId])
  @@index([warehouseId])
  @@index([projectId])
  @@index([assignedEmployeeId])
}

model PpeIssue {
  id           String    @id @default(uuid())
  companyId    String
  company      Company   @relation(fields: [companyId], references: [id])
  employeeId   String
  employee     Employee  @relation(fields: [employeeId], references: [id])
  projectId    String?
  project      Project?  @relation(fields: [projectId], references: [id])
  itemId       String
  item         Item      @relation(fields: [itemId], references: [id])
  serialUnitId String?
  issuedAt     DateTime
  replaceAt    DateTime?
  returnedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([companyId])
  @@index([employeeId])
  @@index([projectId])
  @@index([itemId])
}

model MaterialRequest {
  id             String                @id @default(uuid())
  companyId      String
  company        Company               @relation(fields: [companyId], references: [id])
  number         String
  projectId      String
  project        Project               @relation(fields: [projectId], references: [id])
  warehouseId    String
  warehouse      Warehouse             @relation(fields: [warehouseId], references: [id])
  requestedById  String
  neededDate     DateTime?
  status         DocStatus             @default(DRAFT)
  remarks        String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  deletedAt      DateTime?
  lines          MaterialRequestLine[]
  materialIssues MaterialIssue[]

  @@unique([companyId, number])
  @@index([projectId])
  @@index([warehouseId])
}

model MaterialRequestLine {
  id         String          @id @default(uuid())
  requestId  String
  request    MaterialRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  itemId     String
  item       Item            @relation(fields: [itemId], references: [id])
  wbsNodeId  String?
  wbsNode    WbsNode?        @relation(fields: [wbsNodeId], references: [id])
  costCodeId String?
  costCode   CostCode?       @relation(fields: [costCodeId], references: [id])
  boqItemId  String?
  boqItem    BoqItem?        @relation(fields: [boqItemId], references: [id])
  qty        Decimal         @db.Decimal(18, 4)
  issuedQty  Decimal         @default(0) @db.Decimal(18, 4)
  unit       String
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@index([requestId])
  @@index([itemId])
  @@index([wbsNodeId])
  @@index([costCodeId])
  @@index([boqItemId])
}

// Material Issue Voucher: who, from where, for which project/WBS/cost code, how much, when.
model MaterialIssue {
  id           String              @id @default(uuid())
  companyId    String
  company      Company             @relation(fields: [companyId], references: [id])
  number       String
  projectId    String
  project      Project             @relation(fields: [projectId], references: [id])
  warehouseId  String
  warehouse    Warehouse           @relation(fields: [warehouseId], references: [id])
  requestId    String?
  request      MaterialRequest?    @relation(fields: [requestId], references: [id])
  issueDate    DateTime
  requestedBy  String?
  approvedById String?
  issuedById   String
  receivedBy   String?
  vehicle      String?
  deliveryRef  String?
  signature    String?
  status       DocStatus           @default(DRAFT)
  postedAt     DateTime?
  remarks      String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  deletedAt    DateTime?
  lines        MaterialIssueLine[]

  @@unique([companyId, number])
  @@index([projectId])
  @@index([warehouseId])
  @@index([requestId])
}

model MaterialIssueLine {
  id         String        @id @default(uuid())
  issueId    String
  issue      MaterialIssue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  itemId     String
  item       Item          @relation(fields: [itemId], references: [id])
  wbsNodeId  String?
  wbsNode    WbsNode?      @relation(fields: [wbsNodeId], references: [id])
  costCodeId String?
  costCode   CostCode?     @relation(fields: [costCodeId], references: [id])
  boqItemId  String?
  boqItem    BoqItem?      @relation(fields: [boqItemId], references: [id])
  locationId String?
  qty        Decimal       @db.Decimal(18, 4)
  unit       String
  batchNo    String        @default("")
  serialNo   String?
  unitCost   Decimal       @default(0) @db.Decimal(18, 4)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([issueId])
  @@index([itemId])
  @@index([wbsNodeId])
  @@index([costCodeId])
  @@index([boqItemId])
}

model MaterialReturn {
  id           String               @id @default(uuid())
  companyId    String
  company      Company              @relation(fields: [companyId], references: [id])
  number       String
  projectId    String
  project      Project              @relation(fields: [projectId], references: [id])
  warehouseId  String
  warehouse    Warehouse            @relation(fields: [warehouseId], references: [id])
  returnDate   DateTime
  returnedById String
  reason       String?
  status       DocStatus            @default(DRAFT)
  postedAt     DateTime?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  deletedAt    DateTime?
  lines        MaterialReturnLine[]

  @@unique([companyId, number])
  @@index([projectId])
  @@index([warehouseId])
}

model MaterialReturnLine {
  id         String          @id @default(uuid())
  returnId   String
  return     MaterialReturn  @relation(fields: [returnId], references: [id], onDelete: Cascade)
  itemId     String
  item       Item            @relation(fields: [itemId], references: [id])
  wbsNodeId  String?
  costCodeId String?
  boqItemId  String?
  qty        Decimal         @db.Decimal(18, 4)
  unit       String
  batchNo    String          @default("")
  condition  ReturnCondition @default(GOOD)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@index([returnId])
  @@index([itemId])
}

// Warehouse -> warehouse or project -> project. Preserves cost, batch, serial, ownership.
model WarehouseTransfer {
  id              String                  @id @default(uuid())
  companyId       String
  company         Company                 @relation(fields: [companyId], references: [id])
  number          String
  fromWarehouseId String
  fromWarehouse   Warehouse               @relation("TransferFrom", fields: [fromWarehouseId], references: [id])
  toWarehouseId   String
  toWarehouse     Warehouse               @relation("TransferTo", fields: [toWarehouseId], references: [id])
  fromProjectId   String?
  toProjectId     String?
  transferDate    DateTime
  status          DocStatus               @default(DRAFT)
  postedAt        DateTime?
  remarks         String?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  deletedAt       DateTime?
  lines           WarehouseTransferLine[]

  @@unique([companyId, number])
  @@index([fromWarehouseId])
  @@index([toWarehouseId])
}

model WarehouseTransferLine {
  id         String            @id @default(uuid())
  transferId String
  transfer   WarehouseTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  itemId     String
  item       Item              @relation(fields: [itemId], references: [id])
  qty        Decimal           @db.Decimal(18, 4)
  unit       String
  batchNo    String            @default("")
  serialNo   String?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@index([transferId])
  @@index([itemId])
}

model StockAdjustment {
  id          String                @id @default(uuid())
  companyId   String
  company     Company               @relation(fields: [companyId], references: [id])
  number      String
  warehouseId String
  warehouse   Warehouse             @relation(fields: [warehouseId], references: [id])
  adjustDate  DateTime
  reason      String
  status      DocStatus             @default(DRAFT)
  postedAt    DateTime?
  createdById String
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  deletedAt   DateTime?
  lines       StockAdjustmentLine[]

  @@unique([companyId, number])
  @@index([warehouseId])
}

model StockAdjustmentLine {
  id           String          @id @default(uuid())
  adjustmentId String
  adjustment   StockAdjustment @relation(fields: [adjustmentId], references: [id], onDelete: Cascade)
  itemId       String
  item         Item            @relation(fields: [itemId], references: [id])
  batchNo      String          @default("")
  qtyDelta     Decimal         @db.Decimal(18, 4)
  unitCost     Decimal         @default(0) @db.Decimal(18, 4)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([adjustmentId])
  @@index([itemId])
}

model StockCount {
  id          String           @id @default(uuid())
  companyId   String
  company     Company          @relation(fields: [companyId], references: [id])
  number      String
  warehouseId String
  warehouse   Warehouse        @relation(fields: [warehouseId], references: [id])
  countDate   DateTime
  status      DocStatus        @default(DRAFT)
  postedAt    DateTime?
  createdById String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  deletedAt   DateTime?
  lines       StockCountLine[]

  @@unique([companyId, number])
  @@index([warehouseId])
}

model StockCountLine {
  id            String     @id @default(uuid())
  countId       String
  count         StockCount @relation(fields: [countId], references: [id], onDelete: Cascade)
  itemId        String
  item          Item       @relation(fields: [itemId], references: [id])
  batchNo       String     @default("")
  systemQty     Decimal    @db.Decimal(18, 4)
  physicalQty   Decimal    @db.Decimal(18, 4)
  varianceQty   Decimal    @db.Decimal(18, 4)
  varianceValue Decimal    @db.Decimal(18, 2)
  reason        String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([countId])
  @@index([itemId])
}
