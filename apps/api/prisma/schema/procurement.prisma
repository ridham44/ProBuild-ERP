// Procurement lifecycle: PR -> RFQ -> Quotations -> PO -> Delivery/GRN -> QC -> Supplier invoice (3-way match).

enum PrStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  PARTIALLY_ORDERED
  ORDERED
  CANCELLED
}

enum PoStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  SENT
  PARTIALLY_RECEIVED
  RECEIVED
  CLOSED
  CANCELLED
}

enum RfqStatus {
  DRAFT
  SENT
  QUOTED
  AWARDED
  CLOSED
}

enum QcResult {
  PENDING
  ACCEPTED
  REJECTED
  QUARANTINED
}

enum MatchStatus {
  PENDING
  MATCHED
  DISCREPANCY
  OVERRIDDEN
}

enum Priority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model PurchaseRequisition {
  id             String                    @id @default(uuid())
  companyId      String
  company        Company                   @relation(fields: [companyId], references: [id])
  number         String
  projectId      String
  project        Project                   @relation(fields: [projectId], references: [id])
  warehouseId    String?
  warehouse      Warehouse?                @relation(fields: [warehouseId], references: [id])
  requesterId    String
  priority       Priority                  @default(NORMAL)
  requiredDate   DateTime?
  status         PrStatus                  @default(DRAFT)
  remarks        String?
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt
  deletedAt      DateTime?
  lines          PurchaseRequisitionLine[]
  rfqs           Rfq[]
  purchaseOrders PurchaseOrder[]

  @@unique([companyId, number])
  @@index([projectId])
  @@index([warehouseId])
}

model PurchaseRequisitionLine {
  id                String              @id @default(uuid())
  requisitionId     String
  requisition       PurchaseRequisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  itemId            String
  item              Item                @relation(fields: [itemId], references: [id])
  wbsNodeId         String?
  wbsNode           WbsNode?            @relation(fields: [wbsNodeId], references: [id])
  costCodeId        String?
  costCode          CostCode?           @relation(fields: [costCodeId], references: [id])
  boqItemId         String?
  boqItem           BoqItem?            @relation(fields: [boqItemId], references: [id])
  qty               Decimal             @db.Decimal(18, 4)
  orderedQty        Decimal             @default(0) @db.Decimal(18, 4)
  unit              String
  estimatedUnitCost Decimal             @default(0) @db.Decimal(18, 4)
  requiredDate      DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([requisitionId])
  @@index([itemId])
  @@index([wbsNodeId])
  @@index([costCodeId])
  @@index([boqItemId])
}

model Rfq {
  id                 String               @id @default(uuid())
  companyId          String
  company            Company              @relation(fields: [companyId], references: [id])
  number             String
  requisitionId      String?
  requisition        PurchaseRequisition? @relation(fields: [requisitionId], references: [id])
  projectId          String
  project            Project              @relation(fields: [projectId], references: [id])
  dueDate            DateTime?
  status             RfqStatus            @default(DRAFT)
  awardedQuotationId String?
  remarks            String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  deletedAt          DateTime?
  lines              RfqLine[]
  suppliers          RfqSupplier[]
  quotations         SupplierQuotation[]

  @@unique([companyId, number])
  @@index([requisitionId])
  @@index([projectId])
}

model RfqLine {
  id        String   @id @default(uuid())
  rfqId     String
  rfq       Rfq      @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  itemId    String
  item      Item     @relation(fields: [itemId], references: [id])
  qty       Decimal  @db.Decimal(18, 4)
  unit      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([rfqId])
  @@index([itemId])
}

model RfqSupplier {
  id         String    @id @default(uuid())
  rfqId      String
  rfq        Rfq       @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  supplierId String
  supplier   Supplier  @relation(fields: [supplierId], references: [id])
  sentAt     DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([rfqId, supplierId])
  @@index([supplierId])
}

model SupplierQuotation {
  id           String                  @id @default(uuid())
  companyId    String
  company      Company                 @relation(fields: [companyId], references: [id])
  rfqId        String
  rfq          Rfq                     @relation(fields: [rfqId], references: [id])
  supplierId   String
  supplier     Supplier                @relation(fields: [supplierId], references: [id])
  quoteNo      String?
  quoteDate    DateTime
  validUntil   DateTime?
  deliveryDays Int?
  paymentTerms String?
  warranty     String?
  freight      Decimal                 @default(0) @db.Decimal(18, 2)
  taxAmount    Decimal                 @default(0) @db.Decimal(18, 2)
  totalAmount  Decimal                 @default(0) @db.Decimal(18, 2)
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt
  lines        SupplierQuotationLine[]

  @@unique([rfqId, supplierId])
  @@index([companyId])
  @@index([supplierId])
}

model SupplierQuotationLine {
  id            String            @id @default(uuid())
  quotationId   String
  quotation     SupplierQuotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  itemId        String
  item          Item              @relation(fields: [itemId], references: [id])
  qty           Decimal           @db.Decimal(18, 4)
  unitPrice     Decimal           @db.Decimal(18, 4)
  brand         String?
  specification String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([quotationId])
  @@index([itemId])
}

model PurchaseOrder {
  id               String               @id @default(uuid())
  companyId        String
  company          Company              @relation(fields: [companyId], references: [id])
  number           String
  supplierId       String
  supplier         Supplier             @relation(fields: [supplierId], references: [id])
  projectId        String
  project          Project              @relation(fields: [projectId], references: [id])
  warehouseId      String
  warehouse        Warehouse            @relation(fields: [warehouseId], references: [id])
  requisitionId    String?
  requisition      PurchaseRequisition? @relation(fields: [requisitionId], references: [id])
  quotationId      String?
  orderDate        DateTime
  expectedDate     DateTime?
  deliveryLocation String?
  paymentTerms     String?
  terms            String?
  status           PoStatus             @default(DRAFT)
  subtotal         Decimal              @default(0) @db.Decimal(18, 2)
  discount         Decimal              @default(0) @db.Decimal(18, 2)
  freight          Decimal              @default(0) @db.Decimal(18, 2)
  taxAmount        Decimal              @default(0) @db.Decimal(18, 2)
  totalAmount      Decimal              @default(0) @db.Decimal(18, 2)
  createdById      String
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  deletedAt        DateTime?
  lines            PurchaseOrderLine[]
  goodsReceipts    GoodsReceipt[]
  supplierInvoices SupplierInvoice[]

  @@unique([companyId, number])
  @@index([supplierId])
  @@index([projectId])
  @@index([warehouseId])
  @@index([requisitionId])
}

model PurchaseOrderLine {
  id                String             @id @default(uuid())
  orderId           String
  order             PurchaseOrder      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  itemId            String
  item              Item               @relation(fields: [itemId], references: [id])
  wbsNodeId         String?
  wbsNode           WbsNode?           @relation(fields: [wbsNodeId], references: [id])
  costCodeId        String?
  costCode          CostCode?          @relation(fields: [costCodeId], references: [id])
  boqItemId         String?
  boqItem           BoqItem?           @relation(fields: [boqItemId], references: [id])
  requisitionLineId String?
  qty               Decimal            @db.Decimal(18, 4)
  receivedQty       Decimal            @default(0) @db.Decimal(18, 4)
  invoicedQty       Decimal            @default(0) @db.Decimal(18, 4)
  unit              String
  unitPrice         Decimal            @db.Decimal(18, 4)
  taxPct            Decimal            @default(0) @db.Decimal(7, 4)
  discountPct       Decimal            @default(0) @db.Decimal(7, 4)
  lineTotal         Decimal            @db.Decimal(18, 2)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  goodsReceiptLines GoodsReceiptLine[]

  @@index([orderId])
  @@index([itemId])
  @@index([wbsNodeId])
  @@index([costCodeId])
  @@index([boqItemId])
}

// Goods receipt / delivery receipt. Partial deliveries leave the PO line outstanding.
model GoodsReceipt {
  id           String             @id @default(uuid())
  companyId    String
  company      Company            @relation(fields: [companyId], references: [id])
  number       String
  orderId      String
  order        PurchaseOrder      @relation(fields: [orderId], references: [id])
  supplierId   String
  supplier     Supplier           @relation(fields: [supplierId], references: [id])
  warehouseId  String
  warehouse    Warehouse          @relation(fields: [warehouseId], references: [id])
  receiptDate  DateTime
  supplierDrNo String?
  vehicle      String?
  driver       String?
  status       DocStatus          @default(DRAFT)
  postedAt     DateTime?
  receivedById String
  remarks      String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  deletedAt    DateTime?
  lines        GoodsReceiptLine[]

  @@unique([companyId, number])
  @@index([orderId])
  @@index([supplierId])
  @@index([warehouseId])
}

model GoodsReceiptLine {
  id            String            @id @default(uuid())
  receiptId     String
  receipt       GoodsReceipt      @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  orderLineId   String
  orderLine     PurchaseOrderLine @relation(fields: [orderLineId], references: [id])
  itemId        String
  item          Item              @relation(fields: [itemId], references: [id])
  receivedQty   Decimal           @db.Decimal(18, 4)
  acceptedQty   Decimal           @default(0) @db.Decimal(18, 4)
  rejectedQty   Decimal           @default(0) @db.Decimal(18, 4)
  quarantineQty Decimal           @default(0) @db.Decimal(18, 4)
  unit          String
  unitCost      Decimal           @db.Decimal(18, 4)
  batchNo       String            @default("")
  expiryDate    DateTime?
  qcResult      QcResult          @default(PENDING)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  inspections   QcInspection[]

  @@index([receiptId])
  @@index([orderLineId])
  @@index([itemId])
}

model QcInspection {
  id            String           @id @default(uuid())
  companyId     String
  company       Company          @relation(fields: [companyId], references: [id])
  receiptLineId String
  receiptLine   GoodsReceiptLine @relation(fields: [receiptLineId], references: [id], onDelete: Cascade)
  inspectorId   String
  result        QcResult
  checklist     Json?
  testResult    String?
  certificateNo String?
  remarks       String?
  inspectedAt   DateTime         @default(now())
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([companyId])
  @@index([receiptLineId])
}

model SupplierInvoice {
  id                String                @id @default(uuid())
  companyId         String
  company           Company               @relation(fields: [companyId], references: [id])
  number            String
  supplierInvoiceNo String
  supplierId        String
  supplier          Supplier              @relation(fields: [supplierId], references: [id])
  orderId           String?
  order             PurchaseOrder?        @relation(fields: [orderId], references: [id])
  projectId         String?
  project           Project?              @relation(fields: [projectId], references: [id])
  invoiceDate       DateTime
  dueDate           DateTime?
  subtotal          Decimal               @default(0) @db.Decimal(18, 2)
  discount          Decimal               @default(0) @db.Decimal(18, 2)
  freight           Decimal               @default(0) @db.Decimal(18, 2)
  taxAmount         Decimal               @default(0) @db.Decimal(18, 2)
  withholdingTax    Decimal               @default(0) @db.Decimal(18, 2)
  totalAmount       Decimal               @default(0) @db.Decimal(18, 2)
  paidAmount        Decimal               @default(0) @db.Decimal(18, 2)
  matchStatus       MatchStatus           @default(PENDING)
  matchNotes        Json?
  status            DocStatus             @default(DRAFT)
  journalEntryId    String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  deletedAt         DateTime?
  lines             SupplierInvoiceLine[]

  @@unique([companyId, number])
  @@unique([supplierId, supplierInvoiceNo])
  @@index([orderId])
  @@index([projectId])
}

model SupplierInvoiceLine {
  id          String          @id @default(uuid())
  invoiceId   String
  invoice     SupplierInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  orderLineId String?
  itemId      String?
  description String?
  qty         Decimal         @db.Decimal(18, 4)
  unitPrice   Decimal         @db.Decimal(18, 4)
  taxPct      Decimal         @default(0) @db.Decimal(7, 4)
  lineTotal   Decimal         @db.Decimal(18, 2)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([invoiceId])
}
