// Procurement lifecycle: PR -> RFQ -> Quotations -> PO -> Delivery/GRN -> QC -> Supplier invoice (3-way match).

enum PrStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  PARTIALLY_ORDERED
  ORDERED
  CANCELLED
  CLOSED
}

enum PoStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  SENT
  PARTIALLY_RECEIVED
  RECEIVED
  CLOSED
  CANCELLED
}

enum RfqStatus {
  DRAFT
  SENT
  QUOTED
  AWARDED
  CLOSED
  CANCELLED
}

enum RfqInviteStatus {
  INVITED
  SENT
  QUOTED
  DECLINED
}

enum QuotationStatus {
  SUBMITTED
  AWARDED
  NOT_AWARDED
}

enum QcResult {
  PENDING
  ACCEPTED
  REJECTED
  QUARANTINED
}

enum MatchStatus {
  PENDING
  MATCHED
  DISCREPANCY
  OVERRIDDEN
}

enum Priority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model PurchaseRequisition {
  id             String                    @id @default(uuid())
  companyId      String
  company        Company                   @relation(fields: [companyId], references: [id])
  number         String
  projectId      String
  project        Project                   @relation(fields: [projectId], references: [id])
  warehouseId    String?
  warehouse      Warehouse?                @relation(fields: [warehouseId], references: [id])
  requesterId    String
  priority       Priority                  @default(NORMAL)
  requiredDate   DateTime?
  status         PrStatus                  @default(DRAFT)
  remarks        String?
  purpose        String?
  estimatedTotal Decimal                   @default(0) @db.Decimal(18, 2)
  submittedAt    DateTime?
  approvedAt     DateTime?
  rejectedAt     DateTime?
  cancelledAt    DateTime?
  cancelReason   String?
  closedAt       DateTime?
  closeReason    String?
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt
  deletedAt      DateTime?
  lines          PurchaseRequisitionLine[]
  rfqs           Rfq[]
  purchaseOrders PurchaseOrder[]

  @@unique([companyId, number])
  @@index([projectId])
  @@index([warehouseId])
}

model PurchaseRequisitionLine {
  id                String              @id @default(uuid())
  requisitionId     String
  requisition       PurchaseRequisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  lineNo            Int                 @default(0)
  itemId            String
  item              Item                @relation(fields: [itemId], references: [id])
  description       String?
  justification     String?
  warehouseId       String?
  warehouse         Warehouse?          @relation(fields: [warehouseId], references: [id])
  wbsNodeId         String?
  wbsNode           WbsNode?            @relation(fields: [wbsNodeId], references: [id])
  costCodeId        String?
  costCode          CostCode?           @relation(fields: [costCodeId], references: [id])
  boqItemId         String?
  boqItem           BoqItem?            @relation(fields: [boqItemId], references: [id])
  qty               Decimal             @db.Decimal(18, 4)
  orderedQty        Decimal             @default(0) @db.Decimal(18, 4)
  unit              String
  estimatedUnitCost Decimal             @default(0) @db.Decimal(18, 4)
  requiredDate      DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  rfqLines          RfqLine[]
  orderLines        PurchaseOrderLine[]

  @@index([requisitionId])
  @@index([itemId])
  @@index([warehouseId])
  @@index([wbsNodeId])
  @@index([costCodeId])
  @@index([boqItemId])
}

model Rfq {
  id                   String               @id @default(uuid())
  companyId            String
  company              Company              @relation(fields: [companyId], references: [id])
  number               String
  requisitionId        String?
  requisition          PurchaseRequisition? @relation(fields: [requisitionId], references: [id])
  projectId            String
  project              Project              @relation(fields: [projectId], references: [id])
  dueDate              DateTime?
  status               RfqStatus            @default(DRAFT)
  awardedQuotationId   String?
  remarks              String?
  deliveryRequirements String?
  deliveryLocation     String?
  requiredDate         DateTime?
  createdById          String?
  sentAt               DateTime?
  awardedAt            DateTime?
  closedAt             DateTime?
  cancelledAt          DateTime?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  deletedAt            DateTime?
  lines                RfqLine[]
  suppliers            RfqSupplier[]
  quotations           SupplierQuotation[]
  award                RfqAward?
  purchaseOrders       PurchaseOrder[]

  @@unique([companyId, number])
  @@index([requisitionId])
  @@index([projectId])
}

model RfqLine {
  id                String                   @id @default(uuid())
  rfqId             String
  rfq               Rfq                      @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  requisitionLineId String?
  requisitionLine   PurchaseRequisitionLine? @relation(fields: [requisitionLineId], references: [id])
  lineNo            Int                      @default(0)
  itemId            String
  item              Item                     @relation(fields: [itemId], references: [id])
  description       String?
  qty               Decimal                  @db.Decimal(18, 4)
  unit              String
  requiredDate      DateTime?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  quotationLines    SupplierQuotationLine[]

  @@unique([rfqId, requisitionLineId])
  @@index([rfqId])
  @@index([itemId])
  @@index([requisitionLineId])
}

model RfqSupplier {
  id          String          @id @default(uuid())
  rfqId       String
  rfq         Rfq             @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  supplierId  String
  supplier    Supplier        @relation(fields: [supplierId], references: [id])
  status      RfqInviteStatus @default(INVITED)
  sentAt      DateTime?
  respondedAt DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@unique([rfqId, supplierId])
  @@index([supplierId])
}

model SupplierQuotation {
  id             String                  @id @default(uuid())
  companyId      String
  company        Company                 @relation(fields: [companyId], references: [id])
  rfqId          String
  rfq            Rfq                     @relation(fields: [rfqId], references: [id])
  supplierId     String
  supplier       Supplier                @relation(fields: [supplierId], references: [id])
  quoteNo        String?
  quoteDate      DateTime
  validUntil     DateTime?
  deliveryDays   Int?
  paymentTerms   String?
  warranty       String?
  currency       String                  @default("PHP")
  status         QuotationStatus         @default(SUBMITTED)
  subtotal       Decimal                 @default(0) @db.Decimal(18, 2)
  discountAmount Decimal                 @default(0) @db.Decimal(18, 2)
  freight        Decimal                 @default(0) @db.Decimal(18, 2)
  taxAmount      Decimal                 @default(0) @db.Decimal(18, 2)
  totalAmount    Decimal                 @default(0) @db.Decimal(18, 2)
  createdById    String?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  lines          SupplierQuotationLine[]
  award          RfqAward?
  purchaseOrders PurchaseOrder[]

  @@unique([rfqId, supplierId])
  @@index([companyId])
  @@index([supplierId])
}

model SupplierQuotationLine {
  id                 String              @id @default(uuid())
  quotationId        String
  quotation          SupplierQuotation   @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  rfqLineId          String
  rfqLine            RfqLine             @relation(fields: [rfqLineId], references: [id])
  itemId             String
  item               Item                @relation(fields: [itemId], references: [id])
  qty                Decimal             @db.Decimal(18, 4)
  unitPrice          Decimal             @db.Decimal(18, 4)
  discountPct        Decimal             @default(0) @db.Decimal(7, 4)
  discountAmount     Decimal             @default(0) @db.Decimal(18, 2)
  taxPct             Decimal             @default(0) @db.Decimal(7, 4)
  taxAmount          Decimal             @default(0) @db.Decimal(18, 2)
  lineTotal          Decimal             @default(0) @db.Decimal(18, 2)
  deliveryDate       DateTime?
  brand              String?
  specification      String?
  remarks            String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  purchaseOrderLines PurchaseOrderLine[]

  @@unique([quotationId, rfqLineId])
  @@index([quotationId])
  @@index([itemId])
  @@index([rfqLineId])
}

// Records the decision to buy from one supplier quotation; one award per RFQ.
model RfqAward {
  id          String            @id @default(uuid())
  companyId   String
  rfqId       String            @unique
  rfq         Rfq               @relation(fields: [rfqId], references: [id])
  quotationId String            @unique
  quotation   SupplierQuotation @relation(fields: [quotationId], references: [id])
  supplierId  String
  awardedById String
  awardedAt   DateTime          @default(now())
  reason      String?
  totalAmount Decimal           @db.Decimal(18, 2)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([companyId])
  @@index([supplierId])
}

model PurchaseOrder {
  id               String               @id @default(uuid())
  companyId        String
  company          Company              @relation(fields: [companyId], references: [id])
  number           String
  supplierId       String
  supplier         Supplier             @relation(fields: [supplierId], references: [id])
  projectId        String
  project          Project              @relation(fields: [projectId], references: [id])
  warehouseId      String
  warehouse        Warehouse            @relation(fields: [warehouseId], references: [id])
  requisitionId    String?
  requisition      PurchaseRequisition? @relation(fields: [requisitionId], references: [id])
  quotationId      String?
  quotation        SupplierQuotation?   @relation(fields: [quotationId], references: [id])
  rfqId            String?
  rfq              Rfq?                 @relation(fields: [rfqId], references: [id])
  currency         String               @default("PHP")
  submittedAt      DateTime?
  approvedAt       DateTime?
  rejectedAt       DateTime?
  sentAt           DateTime?
  cancelledAt      DateTime?
  cancelReason     String?
  closedAt         DateTime?
  orderDate        DateTime
  expectedDate     DateTime?
  deliveryLocation String?
  paymentTerms     String?
  terms            String?
  status           PoStatus             @default(DRAFT)
  subtotal         Decimal              @default(0) @db.Decimal(18, 2)
  discount         Decimal              @default(0) @db.Decimal(18, 2)
  freight          Decimal              @default(0) @db.Decimal(18, 2)
  taxAmount        Decimal              @default(0) @db.Decimal(18, 2)
  totalAmount      Decimal              @default(0) @db.Decimal(18, 2)
  createdById      String
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  deletedAt        DateTime?
  lines            PurchaseOrderLine[]
  goodsReceipts    GoodsReceipt[]
  supplierInvoices SupplierInvoice[]

  @@unique([companyId, number])
  @@index([supplierId])
  @@index([projectId])
  @@index([warehouseId])
  @@index([requisitionId])
  @@index([quotationId])
  @@index([rfqId])
}

model PurchaseOrderLine {
  id                String                   @id @default(uuid())
  orderId           String
  order             PurchaseOrder            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  itemId            String
  item              Item                     @relation(fields: [itemId], references: [id])
  wbsNodeId         String?
  wbsNode           WbsNode?                 @relation(fields: [wbsNodeId], references: [id])
  costCodeId        String?
  costCode          CostCode?                @relation(fields: [costCodeId], references: [id])
  boqItemId         String?
  boqItem           BoqItem?                 @relation(fields: [boqItemId], references: [id])
  requisitionLineId String?
  requisitionLine   PurchaseRequisitionLine? @relation(fields: [requisitionLineId], references: [id])
  quotationLineId   String?
  quotationLine     SupplierQuotationLine?   @relation(fields: [quotationLineId], references: [id])
  lineNo            Int                      @default(0)
  description       String?
  deliveryDate      DateTime?
  qty               Decimal                  @db.Decimal(18, 4)
  cancelledQty      Decimal                  @default(0) @db.Decimal(18, 4)
  receivedQty       Decimal                  @default(0) @db.Decimal(18, 4)
  invoicedQty       Decimal                  @default(0) @db.Decimal(18, 4)
  unit              String
  unitPrice         Decimal                  @db.Decimal(18, 4)
  taxPct            Decimal                  @default(0) @db.Decimal(7, 4)
  discountPct       Decimal                  @default(0) @db.Decimal(7, 4)
  discountAmount    Decimal                  @default(0) @db.Decimal(18, 2)
  taxAmount         Decimal                  @default(0) @db.Decimal(18, 2)
  lineTotal         Decimal                  @db.Decimal(18, 2)
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  goodsReceiptLines GoodsReceiptLine[]

  @@index([orderId])
  @@index([requisitionLineId])
  @@index([quotationLineId])
  @@index([itemId])
  @@index([wbsNodeId])
  @@index([costCodeId])
  @@index([boqItemId])
}

// Goods receipt / delivery receipt. Partial deliveries leave the PO line outstanding.
model GoodsReceipt {
  id           String             @id @default(uuid())
  companyId    String
  company      Company            @relation(fields: [companyId], references: [id])
  number       String
  orderId      String
  order        PurchaseOrder      @relation(fields: [orderId], references: [id])
  supplierId   String
  supplier     Supplier           @relation(fields: [supplierId], references: [id])
  warehouseId  String
  warehouse    Warehouse          @relation(fields: [warehouseId], references: [id])
  receiptDate  DateTime
  supplierDrNo String?
  vehicle      String?
  driver       String?
  status       DocStatus          @default(DRAFT)
  postedAt     DateTime?
  receivedById String
  remarks      String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  deletedAt    DateTime?
  lines        GoodsReceiptLine[]

  @@unique([companyId, number])
  @@index([orderId])
  @@index([supplierId])
  @@index([warehouseId])
}

model GoodsReceiptLine {
  id            String            @id @default(uuid())
  receiptId     String
  receipt       GoodsReceipt      @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  orderLineId   String
  orderLine     PurchaseOrderLine @relation(fields: [orderLineId], references: [id])
  itemId        String
  item          Item              @relation(fields: [itemId], references: [id])
  receivedQty   Decimal           @db.Decimal(18, 4)
  acceptedQty   Decimal           @default(0) @db.Decimal(18, 4)
  rejectedQty   Decimal           @default(0) @db.Decimal(18, 4)
  quarantineQty Decimal           @default(0) @db.Decimal(18, 4)
  unit          String
  unitCost      Decimal           @db.Decimal(18, 4)
  batchNo       String            @default("")
  expiryDate    DateTime?
  qcResult      QcResult          @default(PENDING)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  inspections   QcInspection[]

  @@index([receiptId])
  @@index([orderLineId])
  @@index([itemId])
}

model QcInspection {
  id            String           @id @default(uuid())
  companyId     String
  company       Company          @relation(fields: [companyId], references: [id])
  receiptLineId String
  receiptLine   GoodsReceiptLine @relation(fields: [receiptLineId], references: [id], onDelete: Cascade)
  inspectorId   String
  result        QcResult
  checklist     Json?
  testResult    String?
  certificateNo String?
  remarks       String?
  inspectedAt   DateTime         @default(now())
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([companyId])
  @@index([receiptLineId])
}

model SupplierInvoice {
  id                String                @id @default(uuid())
  companyId         String
  company           Company               @relation(fields: [companyId], references: [id])
  number            String
  supplierInvoiceNo String
  supplierId        String
  supplier          Supplier              @relation(fields: [supplierId], references: [id])
  orderId           String?
  order             PurchaseOrder?        @relation(fields: [orderId], references: [id])
  projectId         String?
  project           Project?              @relation(fields: [projectId], references: [id])
  invoiceDate       DateTime
  dueDate           DateTime?
  subtotal          Decimal               @default(0) @db.Decimal(18, 2)
  discount          Decimal               @default(0) @db.Decimal(18, 2)
  freight           Decimal               @default(0) @db.Decimal(18, 2)
  taxAmount         Decimal               @default(0) @db.Decimal(18, 2)
  withholdingTax    Decimal               @default(0) @db.Decimal(18, 2)
  totalAmount       Decimal               @default(0) @db.Decimal(18, 2)
  paidAmount        Decimal               @default(0) @db.Decimal(18, 2)
  matchStatus       MatchStatus           @default(PENDING)
  matchNotes        Json?
  status            DocStatus             @default(DRAFT)
  journalEntryId    String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  deletedAt         DateTime?
  lines             SupplierInvoiceLine[]

  @@unique([companyId, number])
  @@unique([supplierId, supplierInvoiceNo])
  @@index([orderId])
  @@index([projectId])
}

model SupplierInvoiceLine {
  id          String          @id @default(uuid())
  invoiceId   String
  invoice     SupplierInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  orderLineId String?
  itemId      String?
  description String?
  qty         Decimal         @db.Decimal(18, 4)
  unitPrice   Decimal         @db.Decimal(18, 4)
  taxPct      Decimal         @default(0) @db.Decimal(7, 4)
  lineTotal   Decimal         @db.Decimal(18, 2)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([invoiceId])
}
