# Vercel container service. The service root is the repository root, so the build context includes packages/shared.
FROM node:22-bookworm-slim AS base
RUN apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates libcap2-bin \
 && rm -rf /var/lib/apt/lists/*
RUN corepack enable
WORKDIR /repo

FROM base AS build
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json turbo.json .npmrc ./
COPY packages ./packages
COPY apps/api ./apps/api
RUN pnpm install --frozen-lockfile
RUN pnpm --filter @probuild/api exec prisma generate \
 && pnpm --filter @probuild/shared build \
 && pnpm --filter @probuild/api build
RUN pnpm --filter @probuild/api deploy --prod --legacy /out \
 && cp -r apps/api/dist /out/dist \
 && cp -r apps/api/prisma /out/prisma
# deploy installs a fresh @prisma/client without the generated client, so generate again inside /out.
RUN cd /out && /repo/apps/api/node_modules/.bin/prisma generate --schema ./prisma/schema

FROM base AS runtime
ENV NODE_ENV=production
# Vercel proxies to port 80 by default; node may bind it without root.
ENV PORT=80
RUN setcap 'cap_net_bind_service=+ep' "$(readlink -f "$(command -v node)")"
WORKDIR /app
COPY --from=build /out ./
USER node
EXPOSE 80
CMD ["node", "dist/main.js"]
