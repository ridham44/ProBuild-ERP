{
  "name": "@probuild/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "lint": "eslint src test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "vitest run --config vitest.e2e.config.ts --passWithNoTests",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:seed": "tsx prisma/seed.ts",
    "prisma:seed:demo": "tsx prisma/seed-demo.ts",
    "prisma:seed:demo-data": "tsx prisma/seed-demo-data.ts",
    "openapi:generate": "nest build && node dist/cli/generate-openapi.js"
  },
  "prisma": {
    "schema": "prisma/schema"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "latest",
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-express": "11.2.7",
    "@nestjs/schedule": "6.0.1",
    "@nestjs/swagger": "11.4.7",
    "@nestjs/throttler": "6.4.0",
    "@prisma/client": "6.19.3",
    "@probuild/shared": "workspace:*",
    "@sentry/node": "10.14.0",
    "argon2": "0.44.0",
    "cookie-parser": "1.4.7",
    "helmet": "8.1.0",
    "nestjs-pino": "4.4.1",
    "nestjs-zod": "5.5.0",
    "pino": "9.9.0",
    "pino-http": "10.5.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.10",
    "@nestjs/testing": "11.2.7",
    "@probuild/config": "workspace:*",
    "@swc/core": "1.13.5",
    "@types/cookie-parser": "1.4.9",
    "@types/express": "5.0.3",
    "@types/node": "22.18.6",
    "@types/supertest": "6.0.3",
    "eslint": "9.36.0",
    "pino-pretty": "13.1.1",
    "prisma": "6.19.3",
    "supertest": "7.1.4",
    "tsx": "4.20.5",
    "typescript": "5.9.3",
    "unplugin-swc": "1.5.7",
    "vitest": "3.2.7"
  }
}
